{
  // Type-checks the JavaScript from its JSDoc: nothing is compiled.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
